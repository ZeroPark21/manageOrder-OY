      "maxDuration": 60
    },
    "app/api/monthly-matrix/route.ts": {
      "maxDuration": 60
    },
    "app/api/daily-matrix/route.ts": {
      "maxDuration": 60
    },
    "app/api/weekly-matrix/route.ts": {
      "maxDuration": 60
